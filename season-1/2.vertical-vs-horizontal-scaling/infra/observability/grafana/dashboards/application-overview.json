      "targets": [
        {
          "editorMode": "code",
          "expr": "(sum by (implementation) (rate(app_http_requests_total{implementation=~\"$implementation\"}[$__rate_interval])) - sum by (implementation) (rate(app_http_requests_total{implementation=~\"$implementation\",status_code!~\"5..\"}[$__rate_interval]))) / clamp_min(sum by (implementation) (rate(app_http_requests_total{implementation=~\"$implementation\"}[$__rate_interval])), 0.000001)",
