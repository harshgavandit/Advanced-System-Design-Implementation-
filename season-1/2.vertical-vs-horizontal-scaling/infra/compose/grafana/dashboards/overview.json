{
  "uid":"catalog-production-lab","title":"Scaling Lab | Service, Users and Durable Jobs","tags":["synthetic","local","scaling"],"schemaVersion":41,"version":1,"editable":false,"refresh":"5s","time":{"from":"now-15m","to":"now"},"timezone":"browser",
  "panels":[
    {"id":1,"type":"text","title":"Evidence boundary","gridPos":{"x":0,"y":0,"w":24,"h":3},"options":{"mode":"markdown","content":"**Live local synthetic workload.** Product and profile counts come from the owned MongoDB lab. Requests/sec is not unique people. This dashboard does not establish real-user usage, AZ resilience, maximum capacity, or a complete 30-day SLO. Trace/log retention is intentionally short in this local environment."}},
    {"id":2,"type":"stat","title":"Ready API processes","gridPos":{"x":0,"y":3,"w":4,"h":4},"datasource":{"type":"prometheus","uid":"scaling-prometheus"},"targets":[{"refId":"A","expr":"sum(app_readiness{job=\"production-lab-api\"})","instant":true}],"fieldConfig":{"defaults":{"unit":"short","decimals":0,"thresholds":{"mode":"absolute","steps":[{"color":"red","value":null},{"color":"green","value":4}]}}},"options":{"reduceOptions":{"calcs":["lastNotNull"]},"colorMode":"value"}},
    {"id":3,"type":"stat","title":"Synthetic requests / sec","gridPos":{"x":4,"y":3,"w":4,"h":4},"datasource":{"type":"prometheus","uid":"scaling-prometheus"},"targets":[{"refId":"A","expr":"sum(rate(edge_http_requests_total{route=\"/products\",method=\"GET\"}[1m]))"}],"fieldConfig":{"defaults":{"unit":"reqps","decimals":1}},"options":{"reduceOptions":{"calcs":["lastNotNull"]},"graphMode":"area"}},
    {"id":4,"type":"stat","title":"Catalog p95","gridPos":{"x":8,"y":3,"w":4,"h":4},"datasource":{"type":"prometheus","uid":"scaling-prometheus"},"targets":[{"refId":"A","expr":"histogram_quantile(0.95,sum by(le)(rate(edge_http_request_duration_seconds_bucket{route=\"/products\",method=\"GET\"}[1m])))"}],"fieldConfig":{"defaults":{"unit":"s","thresholds":{"mode":"absolute","steps":[{"color":"green","value":null},{"color":"red","value":0.15}]}}},"options":{"reduceOptions":{"calcs":["lastNotNull"]},"colorMode":"value"}},
    {"id":5,"type":"stat","title":"Synthetic catalog products","gridPos":{"x":12,"y":3,"w":4,"h":4},"datasource":{"type":"prometheus","uid":"scaling-prometheus"},"targets":[{"refId":"A","expr":"max(app_ingestion_state{state=\"catalogProducts\"})","instant":true}],"fieldConfig":{"defaults":{"unit":"short","decimals":0}},"options":{"reduceOptions":{"calcs":["lastNotNull"]}}},
    {"id":6,"type":"stat","title":"Synthetic stored profiles","gridPos":{"x":16,"y":3,"w":4,"h":4},"datasource":{"type":"prometheus","uid":"scaling-prometheus"},"targets":[{"refId":"A","expr":"max(app_ingestion_state{state=\"syntheticProfiles\"})","instant":true}],"fieldConfig":{"defaults":{"unit":"short","decimals":0}},"options":{"reduceOptions":{"calcs":["lastNotNull"]}}},
    {"id":7,"type":"stat","title":"Dead-letter messages","gridPos":{"x":20,"y":3,"w":4,"h":4},"datasource":{"type":"prometheus","uid":"scaling-prometheus"},"targets":[{"refId":"A","expr":"max(app_ingestion_state{state=\"dlqVisible\"})","instant":true}],"fieldConfig":{"defaults":{"unit":"short","decimals":0,"thresholds":{"mode":"absolute","steps":[{"color":"green","value":null},{"color":"red","value":1}]}}},"options":{"reduceOptions":{"calcs":["lastNotNull"]},"colorMode":"value"}},
    {"id":8,"type":"timeseries","title":"Catalog traffic distributed across replicas","gridPos":{"x":0,"y":7,"w":12,"h":8},"datasource":{"type":"prometheus","uid":"scaling-prometheus"},"targets":[{"refId":"A","expr":"sum by(replica)(rate(app_http_requests_total{job=\"production-lab-api\",route=\"/products\",method=\"GET\",status_code=\"200\"}[1m]))","legendFormat":"{{replica}}"}],"fieldConfig":{"defaults":{"unit":"reqps"}},"options":{"legend":{"displayMode":"table","placement":"bottom","calcs":["lastNotNull"]}}},
    {"id":9,"type":"timeseries","title":"Combined edge p95 / p99, not averaged replica quantiles","gridPos":{"x":12,"y":7,"w":12,"h":8},"datasource":{"type":"prometheus","uid":"scaling-prometheus"},"targets":[{"refId":"A","expr":"histogram_quantile(0.95,sum by(le)(rate(edge_http_request_duration_seconds_bucket{route=\"/products\"}[1m])))","legendFormat":"p95"},{"refId":"B","expr":"histogram_quantile(0.99,sum by(le)(rate(edge_http_request_duration_seconds_bucket{route=\"/products\"}[1m])))","legendFormat":"p99"}],"fieldConfig":{"defaults":{"unit":"s"}}},
    {"id":10,"type":"timeseries","title":"Whole-container CPU versus assigned quota","gridPos":{"x":0,"y":15,"w":12,"h":8},"datasource":{"type":"prometheus","uid":"scaling-prometheus"},"targets":[{"refId":"A","expr":"100 * max by(replica)(rate(container_cpu_usage_seconds_total{job=\"production-lab-api\"}[1m])) / max by(replica)(container_cpu_limit_cores{job=\"production-lab-api\"})","legendFormat":"{{replica}}"}],"fieldConfig":{"defaults":{"unit":"percent","min":0}}},
    {"id":11,"type":"timeseries","title":"Whole-container memory, separate from process RSS","gridPos":{"x":12,"y":15,"w":12,"h":8},"datasource":{"type":"prometheus","uid":"scaling-prometheus"},"targets":[{"refId":"A","expr":"max by(replica)(container_memory_current_bytes{job=\"production-lab-api\"})","legendFormat":"{{replica}}"}],"fieldConfig":{"defaults":{"unit":"bytes"}}},
    {"id":12,"type":"timeseries","title":"Mongo pool wait and command p95","gridPos":{"x":0,"y":23,"w":12,"h":8},"datasource":{"type":"prometheus","uid":"scaling-prometheus"},"targets":[{"refId":"A","expr":"histogram_quantile(0.95,sum by(le)(rate(app_mongo_pool_checkout_seconds_bucket{job=\"production-lab-api\"}[5m])))","legendFormat":"pool checkout"},{"refId":"B","expr":"histogram_quantile(0.95,sum by(le,command)(rate(app_mongo_command_seconds_bucket{job=\"production-lab-api\"}[5m])))","legendFormat":"{{command}}"}],"fieldConfig":{"defaults":{"unit":"s"}}},
    {"id":13,"type":"timeseries","title":"Public cache operations","gridPos":{"x":12,"y":23,"w":12,"h":8},"datasource":{"type":"prometheus","uid":"scaling-prometheus"},"targets":[{"refId":"A","expr":"sum by(outcome)(rate(app_catalog_cache_operations_total[1m]))","legendFormat":"{{outcome}}"}],"fieldConfig":{"defaults":{"unit":"ops"}}},
    {"id":14,"type":"timeseries","title":"Durable job reconciliation, global values use max","gridPos":{"x":0,"y":31,"w":12,"h":8},"datasource":{"type":"prometheus","uid":"scaling-prometheus"},"targets":[{"refId":"A","expr":"max by(state)(app_ingestion_state{state=~\"accepted|queued|flushed|failed|unsent\"})","legendFormat":"{{state}}"}],"fieldConfig":{"defaults":{"unit":"short","min":0}}},
    {"id":15,"type":"timeseries","title":"Pending job / outbox age and queue depth","gridPos":{"x":12,"y":31,"w":12,"h":8},"datasource":{"type":"prometheus","uid":"scaling-prometheus"},"targets":[{"refId":"A","expr":"max by(state)(app_ingestion_state{state=~\"oldestPendingSeconds|oldestOutboxSeconds|queueVisible|queueInFlight\"})","legendFormat":"{{state}}"}]},
    {"id":16,"type":"timeseries","title":"Edge service failures and client disconnects","gridPos":{"x":0,"y":39,"w":12,"h":8},"datasource":{"type":"prometheus","uid":"scaling-prometheus"},"targets":[{"refId":"A","expr":"sum by(status_code)(rate(edge_http_requests_total{status_code=~\"5..|429|499\"}[1m]))","legendFormat":"{{status_code}}"}],"fieldConfig":{"defaults":{"unit":"reqps","min":0}}},
    {"id":17,"type":"timeseries","title":"Telemetry delivery loss, must remain zero","gridPos":{"x":12,"y":39,"w":12,"h":8},"datasource":{"type":"prometheus","uid":"scaling-prometheus"},"targets":[{"refId":"A","expr":"sum by(reason)(increase(telemetry_events_dropped_total[5m]))","legendFormat":"{{reason}}"}],"fieldConfig":{"defaults":{"unit":"short","min":0}}},
    {"id":18,"type":"logs","title":"Redacted structured logs, TraceID links to Tempo","gridPos":{"x":0,"y":47,"w":24,"h":10},"datasource":{"type":"loki","uid":"scaling-loki"},"targets":[{"refId":"A","expr":"{environment=\"local-synthetic\"}"}],"options":{"showTime":true,"showLabels":false,"wrapLogMessage":true,"sortOrder":"Descending"}}
  ]
}
