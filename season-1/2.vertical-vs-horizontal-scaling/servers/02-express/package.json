{
  "name": "02-express",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "tsup --minify --watch --onSuccess \"node dist/server.js\"",
    "build": "tsup",
    "build:prod": "tsup --minify --clean",
    "start:prod": "pnpm build:prod && NODE_ENV=production node dist/server.js",
    "seed:products": "tsup && node dist/seed-products.js",
    "seed:test": "tsup && NODE_ENV=test node dist/seed-products.js",
    "start:test": "pnpm build:prod && NODE_ENV=test node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "node --test src/migrations/schema.test.ts src/observability/metrics.test.ts src/observability/cgroup.test.ts src/observability/trace-policy.test.ts src/observability/log-buffer.test.ts src/shared/redact.test.ts src/bootstrap/mongo-members.test.ts src/features/ingestion/policy.test.ts src/queue/policy.test.ts src/shared/read-budget.test.ts",
    "mongo:up": "docker compose -f infra/mongo/compose.yaml up -d",
    "mongo:down": "docker compose -f infra/mongo/compose.yaml down",
    "mongo:status": "bash infra/mongo/status.sh",
    "mongo:reset": "docker compose -f infra/mongo/compose.yaml down -v && docker compose -f infra/mongo/compose.yaml up -d"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "3.1146.0",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "0.222.0",
    "@opentelemetry/instrumentation-express": "0.70.0",
    "@opentelemetry/instrumentation-http": "0.222.0",
    "@opentelemetry/instrumentation-mongodb": "0.75.0",
    "@opentelemetry/resources": "2.11.0",
    "@opentelemetry/sdk-node": "0.222.0",
    "@opentelemetry/sdk-trace-base": "2.11.0",
    "bcrypt": "^6.0.0",
    "compression": "1.8.2",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.9.5",
    "negotiator": "^1.1.0",
    "prom-client": "^15.1.3",
    "redis": "^6.2.1",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.19.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/negotiator": "^0.6.5",
    "@types/node": "^26.4.1",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.5.2",
      "onFail": "download"
    }
  },
  "type": "module"
}
