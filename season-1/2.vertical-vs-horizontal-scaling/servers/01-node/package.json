{
  "name": "01-node",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "tsup --minify --watch --onSuccess \"node dist/server.js\"",
    "start": "node dist/server.js",
    "build": "tsup",
    "build:prod": "tsup --minify --clean",
    "start:prod": "pnpm build:prod && NODE_ENV=production node dist/server.js",
    "seed:products": "tsup && node dist/seed-products.js",
    "seed:test": "tsup && NODE_ENV=test node dist/seed-products.js",
    "start:test": "pnpm build:prod && NODE_ENV=test node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "node --test src/observability/metrics.test.ts",
    "mongo:up": "docker compose -f infra/mongo/compose.yaml up -d",
    "mongo:down": "docker compose -f infra/mongo/compose.yaml down",
    "mongo:status": "bash infra/mongo/status.sh",
    "mongo:reset": "docker compose -f infra/mongo/compose.yaml down -v && docker compose -f infra/mongo/compose.yaml up -d"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "dotenv": "^17.4.2",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.9.5",
    "negotiator": "^1.1.0",
    "prom-client": "^15.1.3",
    "redis": "^6.2.1",
    "swagger-jsdoc": "^6.3.0",
    "winston": "^3.19.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/negotiator": "^0.6.5",
    "@types/node": "^26.4.1",
    "@types/swagger-jsdoc": "^6.0.4",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.5.2",
      "onFail": "download"
    }
  },
  "type": "module"
}
