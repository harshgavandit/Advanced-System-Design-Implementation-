{
  "name": "04-nestjs",
  "version": "1.0.0",
  "description": "NestJS on Fastify. Same Flipkart API routes as the other season-1 servers.",
  "type": "module",
  "scripts": {
    "dev": "tsc-watch -p tsconfig.build.json --onSuccess \"node dist/main.js\"",
    "build": "tsc -p tsconfig.build.json",
    "build:prod": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:prod": "NODE_ENV=production node dist/main.js",
    "seed:products": "tsc -p tsconfig.build.json && node dist/seed/seed-products.js",
    "seed:test": "tsc -p tsconfig.build.json && NODE_ENV=test node dist/seed/seed-products.js",
    "start:test": "tsc -p tsconfig.build.json && NODE_ENV=test node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "oxlint",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.config.e2e.ts",
    "mongo:up": "docker compose -f infra/mongo/compose.yaml up -d",
    "mongo:down": "docker compose -f infra/mongo/compose.yaml down",
    "mongo:status": "bash infra/mongo/status.sh",
    "mongo:reset": "docker compose -f infra/mongo/compose.yaml down -v && docker compose -f infra/mongo/compose.yaml up -d"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/static": "^8.3.0",
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-fastify": "^12.0.1",
    "@nestjs/swagger": "^12.0.1",
    "bcrypt": "^6.0.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.5",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.9.5",
    "negotiator": "^1.1.0",
    "prom-client": "^15.1.3",
    "redis": "^6.2.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "winston": "^3.19.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/negotiator": "^0.6.5",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "oxlint": "^1.58.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "tsc-watch": "^7.2.1",
    "typescript": "^7.0.2",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.2"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.5.2",
      "onFail": "download"
    }
  }
}
