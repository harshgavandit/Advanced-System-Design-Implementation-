{
  "apps": [
    {
      "name": "nestjs-dev",
      "script": "pnpm",
      "args": "dev",
      "exec_mode": "fork",
      "instances": 1,
      "watch": false,
      "env": { "NODE_ENV": "development" },
      "error_file": "./logs/dev-error.log",
      "out_file": "./logs/dev-out.log",
      "merge_logs": true,
      "log_date_format": "YYYY-MM-DD HH:mm:ss"
    },
    {
      "name": "nestjs-prod",
      "script": "dist/main.js",
      "exec_mode": "cluster",
      "instances": 4,
      "watch": false,
      "max_memory_restart": "1G",
      "exp_backoff_restart_delay": 100,
      "min_uptime": "10s",
      "max_restarts": 10,
      "env": { "NODE_ENV": "production" },
      "error_file": "./logs/prod-error.log",
      "out_file": "./logs/prod-out.log",
      "merge_logs": true,
      "log_date_format": "YYYY-MM-DD HH:mm:ss"
    },
    {
      "name": "nestjs-test-single",
      "script": "dist/main.js",
      "exec_mode": "fork",
      "instances": 1,
      "watch": false,
      "env": { "NODE_ENV": "test" },
      "error_file": "./logs/test-single-error.log",
      "out_file": "./logs/test-single-out.log",
      "merge_logs": true,
      "log_date_format": "YYYY-MM-DD HH:mm:ss"
    },
    {
      "name": "nestjs-test-cluster",
      "script": "dist/main.js",
      "exec_mode": "cluster",
      "instances": 4,
      "watch": false,
      "env": { "NODE_ENV": "test" },
      "error_file": "./logs/test-cluster-error.log",
      "out_file": "./logs/test-cluster-out.log",
      "merge_logs": true,
      "log_date_format": "YYYY-MM-DD HH:mm:ss"
    }
  ]
}
