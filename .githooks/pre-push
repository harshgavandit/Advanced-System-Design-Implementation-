#!/bin/bash
# Rejects non-fast-forward updates. A normal first push of a branch is allowed.
set -u

zero="0000000000000000000000000000000000000000"
blocked=0

while read -r local_ref local_sha remote_ref remote_sha; do
  [[ -z "${local_ref:-}" ]] && continue
  if [[ "$local_sha" == "$zero" ]]; then
    printf 'Blocked delete of %s\n' "$remote_ref" >&2
    blocked=1
    continue
  fi
  if [[ "$remote_sha" == "$zero" ]]; then
    continue
  fi
  if ! git merge-base --is-ancestor "$remote_sha" "$local_sha" >/dev/null 2>&1; then
    printf 'Blocked non-fast-forward push to %s\n' "$remote_ref" >&2
    blocked=1
  fi
done

exit "$blocked"
